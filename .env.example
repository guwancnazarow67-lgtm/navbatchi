# NAVBATCHI sozlamalari. Bu faylni ".env" nomi bilan nusxalang va kerakli qiymatlarni o'zgartiring.
# Hammasi ixtiyoriy: SECRET_KEY va VAPID kalitlari bo'sh qolsa, avtomatik yaratiladi (data/secrets.json).

# Sayt manzili (QR-kod va havolalar shu manzil bilan yaratiladi). HTTPS bo'lsa COOKIE_SECURE avtomatik yoqiladi.
BASE_URL=
# Nginx/Caddy orqasida ishlatsangiz 1 qiling
BEHIND_PROXY=0
# Eslatmalar yuboriladigan soat (Toshkent vaqti bilan)
NOTIFY_HOUR=8
TIMEZONE=Asia/Tashkent
# Push uchun aloqa manzili (mailto: yoki https://)
VAPID_SUBJECT=mailto:admin@example.com

# Birinchi ishga tushishda administratorni avtomatik yaratish (ixtiyoriy; Docker uchun qulay)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Dastur qaysi manzil/portda tinglaydi (run.py uchun). Telefondan kirish uchun HOST=0.0.0.0
HOST=127.0.0.1
PORT=5000
